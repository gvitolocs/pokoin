[Unit]
Description=Pokoin Rust marketplace API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nes
Group=nes
ExecStart=/srv/pokoin/rust/current
Restart=on-failure
RestartSec=2
Environment=POKOIN_RUST_BIND=127.0.0.1:18082
Environment=RUST_LOG=info
EnvironmentFile=-/srv/pokoin/rust/pokoin-api.env
MemoryHigh=400M
MemoryMax=700M
CPUQuota=150%
LimitNOFILE=65535
KillSignal=SIGTERM
TimeoutStopSec=20
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
