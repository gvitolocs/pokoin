[Unit]
Description=Pokoin native job cardtrader-facet-prices (CardTrader price store refill)

[Timer]
# An hour after each CardRails price-book build (nezopt price-book.timer,
# 03:30 and 17:30 UTC); the 04:30 run also follows the 23:00 UTC daily dump.
OnCalendar=*-*-* 04:30:00 UTC
OnCalendar=*-*-* 18:30:00 UTC
RandomizedDelaySec=2min
Persistent=true
Unit=pokoin-rust-job@cardtrader-facet-prices.service

[Install]
WantedBy=timers.target
