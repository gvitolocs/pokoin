[Unit]
Description=Deploy the Pokoin Rust API from origin/main when it changed (docs/AUTO_DEPLOY.md)
# Built switched off: install and enable by hand, see docs/AUTO_DEPLOY.md.

[Service]
Type=oneshot
Nice=10
# CPUQuota= is left to scripts/build-pokoin-rust-release.sh, which sets its own limits for the build.
# The build, the test gate and the Pi install can take over an hour.
TimeoutStartSec=3h
# The canonical deploy checkout. The script flocks, so overlapping triggers exit at once. It runs from a copy
# of itself, because a merge moves this checkout under a long run. Exit 1 or 3 (a failed step, a pending
# migration) fails the unit, and the user-wide OnFailure= drop-in (service.d/90-alert.conf) mails the owner.
ExecStart=/home/nez/Projects/pokoin-web/scripts/auto-deploy-rust.sh
