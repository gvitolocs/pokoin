[Unit]
Description=Pokoin native job cardtrader-seller-reconcile (CardTrader seller reconcile)

[Timer]
OnBootSec=2min
OnActiveSec=1min
# Counted from the end of the previous run. OnUnitActiveSec=5min counted from
# its start, so 7-minute runs chained back to back on the Pi (2026-10-10).
OnUnitInactiveSec=10min
RandomizedDelaySec=20s
Persistent=true
Unit=pokoin-rust-job@cardtrader-seller-reconcile.service

[Install]
WantedBy=timers.target
