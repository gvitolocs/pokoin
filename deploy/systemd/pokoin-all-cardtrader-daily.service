[Unit]
Description=Pokoin all-game CardTrader catalogues, pictures and raw daily books on nezopt
After=network-online.target docker.service
[Service]
Type=oneshot
WorkingDirectory=/home/nez/Projects/pokoin-web
# Optional: POKOIN_PRICE_CACHE_PG_USER=pokoin_jobs and its password (mode 600),
# docs/SECURITY_HARDENING.md "Least-privilege roles". Without it the price cache
# logs in as the container superuser, as before.
EnvironmentFile=-%h/.config/pokoin/price-cache-pg.env
ExecStart=/usr/bin/flock -n /home/nez/data/pokoin-catalog-refresh/daily.lock /bin/bash scripts/run-all-cardtrader-daily.sh
TimeoutStartSec=12h
Nice=10
