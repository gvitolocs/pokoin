[Unit]
Description=Start the Pokoin Rust deploy check when origin/main moves in the canonical checkout (docs/AUTO_DEPLOY.md)

[Path]
# The canonical checkout /home/nez/Projects/pokoin-web. These files change only when something runs
# `git fetch` (or pull) there: nothing in this unit fetches. The timer does it through the script every 15 min,
# and a manual or agent fetch fires this path at once.
PathChanged=/home/nez/Projects/pokoin-web/.git/refs/remotes/origin/main
PathChanged=/home/nez/Projects/pokoin-web/.git/packed-refs
# A fetch can touch both files: several triggers in a row start the service once.
TriggerLimitIntervalSec=10
TriggerLimitBurst=5

[Install]
WantedBy=default.target
