# ~/.config/pokoin/backup.env on nezopt (0600).
POKOIN_BACKUP_DIR=/home/nez/mnt/mybook/pokoin-backups
POKOIN_BACKUP_REQUIRE_MOUNT=/home/nez/mnt/mybook
# pg_dump runs inside the Pi replica container; it refuses anything not in recovery.
POKOIN_BACKUP_EXEC=ssh -o BatchMode=yes -o ConnectTimeout=20 -o ServerAliveInterval=30 pi-home docker exec -i pokoin-marketplace-postgres-replica
# Off-site copy of the dump sets (rclone remote:bucket); append-only key, provider
# lifecycle deletes daily/ after 15 days and weekly/ after 57 days.
POKOIN_BACKUP_RCLONE_REMOTE=pokoin-dumps:pokoin-pg-dumps
POKOIN_RCLONE=/home/nez/.local/bin/rclone
# wal-g store → mybook mirror (read-only key) and the PITR test that reads the mirror.
POKOIN_WALG_RCLONE_REMOTE=pokoin-walg-ro:pokoin-pg-walg
POKOIN_WALG_MIRROR_DIR=/home/nez/mnt/mybook/pokoin-backups/walg-mirror
POKOIN_WALG=/home/nez/.local/bin/wal-g
POKOIN_WALG_MIRROR_ENV=/home/nez/.config/pokoin/walg-mirror.env
