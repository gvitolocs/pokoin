# ~/.config/pokoin/alerts.env on nezopt (0600). The Resend key already comes from
# ~/.config/pokoin/uptime-mail.env, which pokoin-ops reads too.
POKOIN_HC_PING_KEY=...
POKOIN_HC_SLUG_PREFIX=nezopt-
# For `pokoin-ops hc-provision` only (healthchecks project API key, read-write).
# POKOIN_HC_API_KEY=...
# Required: the only place the alert recipient comes from. Without it pokoin-ops refuses to send mail.
POKOIN_ALERT_MAIL_TO=alerts@example.invalid
# Required: the sender shown on alert mail (a verified sender for the mail provider).
POKOIN_ALERT_MAIL_FROM=Alerts <alerts@example.invalid>
