# ~/.config/pokoin/alerts.env on nezopt (0600). The Resend key already comes from
# ~/.config/pokoin/uptime-mail.env, which pokoin-ops reads too.
POKOIN_HC_PING_KEY=...
POKOIN_HC_SLUG_PREFIX=nezopt-
# For `pokoin-ops hc-provision` only (healthchecks project API key, read-write).
# POKOIN_HC_API_KEY=...
