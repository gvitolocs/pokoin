# ~/.config/pokoin/walg-mirror.env on nezopt (0600): wal-g reading the mybook mirror.
WALG_FILE_PREFIX=/home/nez/mnt/mybook/pokoin-backups/walg-mirror/pokoin-marketplace
WALG_COMPRESSION_METHOD=zstd
WALG_LIBSODIUM_KEY=...                # same key as the Pi's /etc/pokoin/walg.env
WALG_LIBSODIUM_KEY_TRANSFORM=hex
