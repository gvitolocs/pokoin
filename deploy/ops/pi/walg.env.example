# /etc/pokoin/walg.env on the Pi (root 0600). wal-g reads its whole config from here.
# Off-site store: an S3-compatible bucket only for wal-g (it needs delete for retention).
WALG_S3_PREFIX=s3://pokoin-pg-walg/pokoin-marketplace
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
AWS_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
AWS_REGION=eu-central-003
AWS_S3_FORCE_PATH_STYLE=true
WALG_COMPRESSION_METHOD=zstd
# Client-side encryption. 32 random bytes as hex: openssl rand -hex 32. Keep an offline copy.
WALG_LIBSODIUM_KEY=...
WALG_LIBSODIUM_KEY_TRANSFORM=hex
# The standby, from the Pi host: connections arrive from the Docker bridge (scram + TLS).
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=pokoin_marketplace
PGPASSWORD=...
PGSSLMODE=require
PGDATABASE=postgres
# Throttle the weekly base backup so the API keeps the disk and the uplink.
WALG_DISK_RATE_LIMIT=31457280
WALG_NETWORK_RATE_LIMIT=12582912
WALG_UPLOAD_CONCURRENCY=2
WALG_PREVENT_WAL_OVERWRITE=true
