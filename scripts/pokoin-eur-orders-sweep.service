[Unit]
Description=Pokoin EUR order sweep (expire stale Stripe holds, recover missed payments)
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/flock -n /run/lock/pokoin-eur-orders-sweep.lock /usr/bin/docker exec -w /app pokoin-oracle-api node /app/api/eur-orders-sweep.js
TimeoutStartSec=10min
Nice=10

[Install]
WantedBy=multi-user.target
