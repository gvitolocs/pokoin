[Unit]
Description=Pokoin platform sync order poll (Shopify, Cardmarket, TCGplayer, …)
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/flock -n /run/lock/pokoin-platform-sync-poll.lock /usr/bin/docker exec -w /app pokoin-oracle-api node /app/api/platform-sync-poll-all.js
TimeoutStartSec=20min
Nice=10

[Install]
WantedBy=multi-user.target
