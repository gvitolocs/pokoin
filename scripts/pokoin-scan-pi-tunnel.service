[Unit]
Description=Pokoin card recognition: nezopt GPU worker (8099) to the Pi API (127.0.0.1:18151)
After=network-online.target battlescan-fast.service
Wants=network-online.target battlescan-fast.service

[Service]
Type=simple
ExecStart=/usr/bin/ssh -NT -o BatchMode=yes -o ConnectTimeout=5 -o ExitOnForwardFailure=yes -o ServerAliveInterval=15 -o ServerAliveCountMax=3 -R 127.0.0.1:18151:127.0.0.1:8099 pi-home
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
