[Unit]
Description=Roll Pokoin listing sold/new stats into Oracle card weights
After=docker.service

[Service]
Type=oneshot
User=root
Environment=POKOIN_MARKETPLACE_POSTGRES=pokoin-marketplace-postgres-replica
ExecStart=/usr/bin/python3 /srv/pokoin/scripts/refresh-listing-weights.py
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=300
