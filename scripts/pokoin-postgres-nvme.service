[Unit]
Description=Pokoin marketplace writer Postgres (NVMe)
After=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/docker start pokoin-marketplace-postgres-15t
ExecStop=/usr/bin/docker stop --time 60 pokoin-marketplace-postgres-15t
TimeoutStartSec=120
TimeoutStopSec=120

[Install]
WantedBy=default.target
