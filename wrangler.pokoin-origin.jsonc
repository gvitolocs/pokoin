{
  "name": "pokoin-origin",
  "main": "workers/pokoin-origin.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "observability": { "enabled": true },
  "vars": {
    "API_ORIGIN": "https://api.pokoin.com"
  },
  "routes": [
    { "pattern": "pokoin.com/marketplace/en*", "zone_name": "pokoin.com" },
    { "pattern": "pokoin.com/profile*", "zone_name": "pokoin.com" },
    { "pattern": "pokoin.com/auth*", "zone_name": "pokoin.com" },
    { "pattern": "pokoin.com/cart*", "zone_name": "pokoin.com" },
    { "pattern": "pokoin.com/wallet*", "zone_name": "pokoin.com" },
    { "pattern": "pokoin.com/checkout*", "zone_name": "pokoin.com" },
    { "pattern": "pokoin.com/orders*", "zone_name": "pokoin.com" },
    { "pattern": "pokoin.com/inventory*", "zone_name": "pokoin.com" },
    { "pattern": "pokoin.com/nft*", "zone_name": "pokoin.com" },
    { "pattern": "pokoin.com/buy*", "zone_name": "pokoin.com" },
    { "pattern": "pokoin.com/api/*", "zone_name": "pokoin.com" },
    { "pattern": "pokoin.com/market*", "zone_name": "pokoin.com" },
    { "pattern": "pokoin.com/home*", "zone_name": "pokoin.com" },
    { "pattern": "pokoin.com/working*", "zone_name": "pokoin.com" },
    { "pattern": "pokoin.com/download*", "zone_name": "pokoin.com" },
    { "pattern": "www.pokoin.com/marketplace/en*", "zone_name": "pokoin.com" },
    { "pattern": "www.pokoin.com/profile*", "zone_name": "pokoin.com" },
    { "pattern": "www.pokoin.com/auth*", "zone_name": "pokoin.com" },
    { "pattern": "www.pokoin.com/cart*", "zone_name": "pokoin.com" },
    { "pattern": "www.pokoin.com/wallet*", "zone_name": "pokoin.com" },
    { "pattern": "www.pokoin.com/checkout*", "zone_name": "pokoin.com" },
    { "pattern": "www.pokoin.com/orders*", "zone_name": "pokoin.com" },
    { "pattern": "www.pokoin.com/inventory*", "zone_name": "pokoin.com" },
    { "pattern": "www.pokoin.com/nft*", "zone_name": "pokoin.com" },
    { "pattern": "www.pokoin.com/buy*", "zone_name": "pokoin.com" },
    { "pattern": "www.pokoin.com/api/*", "zone_name": "pokoin.com" },
    { "pattern": "www.pokoin.com/market*", "zone_name": "pokoin.com" },
    { "pattern": "www.pokoin.com/home*", "zone_name": "pokoin.com" },
    { "pattern": "www.pokoin.com/working*", "zone_name": "pokoin.com" },
    { "pattern": "www.pokoin.com/download*", "zone_name": "pokoin.com" },
    { "pattern": "onepiece.pokoin.com/marketplace/en*", "zone_name": "pokoin.com" },
    { "pattern": "onepiece.pokoin.com/api/*", "zone_name": "pokoin.com" },
    { "pattern": "onepiece.pokoin.com/market*", "zone_name": "pokoin.com" },
    { "pattern": "riftbound.pokoin.com/marketplace/en*", "zone_name": "pokoin.com" },
