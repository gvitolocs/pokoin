{
  "name": "pokoin-shortlink",
  "main": "workers/pokoin-shortlink.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "observability": { "enabled": true },
  "cache": { "enabled": true },
  "build": {
    "command": "gzip -dc workers/card-slug-blob.gz > workers/card-slug-blob.txt"
  },
  "rules": [
    { "type": "Text", "globs": ["workers/card-slug-blob.txt"], "fallthrough": true },
    { "type": "Data", "globs": ["**/*.gz"], "fallthrough": true }
  ],
  "routes": [
    {
      "pattern": "pokoin.com/*",
      "zone_name": "pokoin.com"
    },
    {
      "pattern": "www.pokoin.com/*",
      "zone_name": "pokoin.com"
    }
  ]
}
