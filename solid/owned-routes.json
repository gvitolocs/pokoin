{
  "enabled": true,
  "canary": 100,
  "patterns": [
    "^/marketplace/?$",
    "^/marketplace/search/?$",
    "^/marketplace/[a-z]{2,3}/cards/[^/]+(?:/[^/]+)?/?$",
    "^/marketplace/[a-z]{2,3}/cards/[^/]+(?:/[^/]+)?/versions/?$",
    "^/auth/?$",
    "^/extension/auth-bridge/?$",
    "^/profile/?$",
    "^/dashboard/?$",
    "^/stock/?$",
    "^/messages(?:/[^/]+)?/?$",
    "^/associate/?$",
    "^/mypokoin(?:/(?:zero|1dr|spreadsheet|import|settings|collection|location/[^/]+))?/?$",
    "^/inventory/?$",
    "^/collection/?$",
    "^/marketplace/portfolio(?:/[^/]+)?/?$",
    "^/invite/?$",
    "^/join/[^/]+/?$",
    "^/ambassador(?:program)?/?$",
    "^/email-preferences/?$",
    "^/cart/?$",
    "^/checkout/?$",
    "^/orders/?$",
    "^/bought/?$",
    "^/buy/?$",
    "^/sales/?$",
    "^/wallet/?$",
    "^/exchange/?$",
    "^/swap/?$",
    "^/nft/?$",
    "^/flex/?$",
    "^/shipping/?$",
    "^/protection/?$",
    "^/marketplace/signal/?$",
    "^/marketplace/(?:explore|watchlist)/?$",
    "^/favorites/?$",
    "^/product(?:/[^/]+)?/?$",
    "^/marketplace/competitive(?:/(?:tournaments|decks|players|cards)(?:/[^/]+)?|/decklists/[^/]+)?/?$",
    "^/marketplace/(?:sets|eras)(?:/[^/]+)?/?$",
    "^/marketplace/[a-z]{2,3}/(?:artists|pokemon|rarities|languages|guides)(?:/[^/]+)?/?$",
    "^/marketplace/[a-z]{2,3}/users/[^/]+/?$",
    "^/(?:docs|contact|privacy|earn|whitepaper|health|sitemap)/?$"
  ]
}
